title: "AutoTAB: Automatic Tracking Algorithm for Bipolar Magnetic Regions"
authors:
  - family-names: Sreedevi
    given-names: Anu B.
  - family-names: Jha
    given-names: Bibhuti Kumar
    orcid: "https://orcid.org/0000-0002-6374-4616"
